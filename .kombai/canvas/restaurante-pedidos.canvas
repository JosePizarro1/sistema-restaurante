      "html": "<div class=\"flex bg-[#F7F8FA] h-screen w-full font-['Atkinson_Hyperlegible'] text-[#15202B] overflow-hidden\" data-kid=\"1\" data-name=\"page layout container\">\n    <!-- Sidebar -->\n    <aside class=\"w-[88px] h-full bg-white border-r border-gray-100 flex flex-shrink-0 flex-col items-center py-6 gap-8 z-20\" data-kid=\"1-1\" data-name=\"sidebar container\">\n        <div class=\"w-12 h-12 bg-[#F56B45]/10 rounded-xl flex items-center justify-center text-[#F56B45] mb-2\" data-kid=\"1-1-1\" data-name=\"kitchen tool icon wrapper\">\n            <i class=\"ti ti-tools-kitchen-2 text-2xl\" data-kid=\"1-1-1-1\" data-name=\"kitchen tool icon\">\n            </i>\n        </div>\n        <nav class=\"flex flex-col gap-5 flex-1 overflow-y-auto no-scrollbar py-2\" data-kid=\"1-1-2\" data-name=\"navigation menu\">\n            <a class=\"nav-item flex flex-col items-center gap-1 group\" data-kid=\"1-1-2-1\" data-name=\"dashboard navigation item\" href=\"#\">\n                <div class=\"w-14 h-14 text-gray-300 rounded-[18px] flex items-center justify-center group-hover:bg-gray-50 transition-all\" data-kid=\"1-1-2-1-1\" data-name=\"dashboard icon wrapper\">\n                    <i class=\"ti ti-layout-dashboard text-2xl\" data-kid=\"1-1-2-1-1-1\" data-name=\"dashboard icon\">\n                    </i>\n                </div>\n                <span class=\"text-[10px] font-bold uppercase tracking-wider text-gray-400 group-hover:text-gray-600\" data-kid=\"1-1-2-1-2\" data-name=\"dashboard label text\">\n                    Menú\n                </span>\n            </a>\n            <a class=\"nav-item flex flex-col items-center gap-1 group\" data-kid=\"1-1-2-2\" data-name=\"tables navigation item\" href=\"#\">\n                <div class=\"w-14 h-14 text-gray-300 rounded-[18px] flex items-center justify-center group-hover:bg-gray-50 transition-all\" data-kid=\"1-1-2-2-1\" data-name=\"tables icon wrapper\">\n                    <i class=\"ti ti-armchair text-2xl\" data-kid=\"1-1-2-2-1-1\" data-name=\"tables icon\">\n                    </i>\n                </div>\n                <span class=\"text-[10px] font-bold uppercase tracking-wider text-gray-400 group-hover:text-gray-600\" data-kid=\"1-1-2-2-2\" data-name=\"tables label text\">\n                    Mesas\n                </span>\n            </a>\n            <a class=\"nav-item flex flex-col items-center gap-1 group\" data-kid=\"1-1-2-3\" data-name=\"orders list navigation item\" href=\"#\">\n                <div class=\"w-14 h-14 text-gray-300 rounded-[18px] flex items-center justify-center group-hover:bg-gray-50 transition-all\" data-kid=\"1-1-2-3-1\" data-name=\"orders list icon wrapper\">\n                    <i class=\"ti ti-clipboard-list text-2xl\" data-kid=\"1-1-2-3-1-1\" data-name=\"orders list icon\">\n                    </i>\n                </div>\n                <span class=\"text-[10px] font-bold uppercase tracking-wider text-gray-400 group-hover:text-gray-600\" data-kid=\"1-1-2-3-2\" data-name=\"orders list label text\">\n                    Comandas\n                </span>\n            </a>\n            <!-- Active: Cocina -->\n            <a class=\"nav-item flex flex-col items-center gap-1 group\" data-kid=\"1-1-2-4\" data-name=\"kitchen navigation item\" href=\"#\">\n                <div class=\"w-14 h-14 bg-[#F56B45] text-white rounded-[18px] flex items-center justify-center shadow-lg shadow-[#F56B45]/25\" data-kid=\"1-1-2-4-1\" data-name=\"kitchen icon wrapper\">\n                    <i class=\"ti ti-tools-kitchen-2 text-2xl\" data-kid=\"1-1-2-4-1-1\" data-name=\"kitchen icon\">\n                    </i>\n                </div>\n                <span class=\"text-[10px] font-bold uppercase tracking-wider text-[#F56B45]\" data-kid=\"1-1-2-4-2\" data-name=\"kitchen label text\">\n                    Cocina\n                </span>\n            </a>\n            <a class=\"nav-item flex flex-col items-center gap-1 group\" data-kid=\"1-1-2-5\" data-name=\"reports navigation item\" href=\"#\">\n                <div class=\"w-14 h-14 text-gray-300 rounded-[18px] flex items-center justify-center group-hover:bg-gray-50 transition-all\" data-kid=\"1-1-2-5-1\" data-name=\"reports icon wrapper\">\n                    <i class=\"ti ti-chart-bar text-2xl\" data-kid=\"1-1-2-5-1-1\" data-name=\"reports icon\">\n                    </i>\n                </div>\n                <span class=\"text-[10px] font-bold uppercase tracking-wider text-gray-400 group-hover:text-gray-600\" data-kid=\"1-1-2-5-2\" data-name=\"reports label text\">\n                    Reportes\n                </span>\n            </a>\n            <a class=\"nav-item flex flex-col items-center gap-1 group\" data-kid=\"1-1-2-6\" data-name=\"settings navigation item\" href=\"#\">\n                <div class=\"w-14 h-14 text-gray-300 rounded-[18px] flex items-center justify-center group-hover:bg-gray-50 transition-all\" data-kid=\"1-1-2-6-1\" data-name=\"settings icon wrapper\">\n                    <i class=\"ti ti-settings text-2xl\" data-kid=\"1-1-2-6-1-1\" data-name=\"settings icon\">\n                    </i>\n                </div>\n                <span class=\"text-[10px] font-bold uppercase tracking-wider text-gray-400 group-hover:text-gray-600\" data-kid=\"1-1-2-6-2\" data-name=\"settings label text\">\n                    Ajustes\n                </span>\n            </a>\n        </nav>\n        <div class=\"mt-auto flex flex-col items-center gap-6\" data-kid=\"1-1-3\" data-name=\"user profile section\">\n            <div class=\"w-12 h-12 rounded-full overflow-hidden border-2 border-white shadow-md ring-4 ring-gray-50/50\" data-kid=\"1-1-3-1\" data-name=\"user avatar image wrapper\">\n                <img alt=\"Cocina\" class=\"w-full h-full object-cover\" data-kid=\"1-1-3-1-1\" data-name=\"user avatar image\" decoding=\"async\" loading=\"lazy\" src=\"https://i.pravatar.cc/100?u=chef1\"/>\n            </div>\n        </div>\n    </aside>\n    <!-- Main Content Area -->\n    <main class=\"flex-1 flex flex-col overflow-hidden\" data-kid=\"1-2\" data-name=\"main content area\">\n        <!-- Header -->\n        <header class=\"h-20 bg-white border-b border-gray-100 flex items-center justify-between px-8 flex-shrink-0 z-10\" data-kid=\"1-2-1\" data-name=\"header bar\">\n            <div class=\"flex flex-col\" data-kid=\"1-2-1-1\" data-name=\"breadcrumb and title group\">\n                <nav class=\"text-[11px] font-bold uppercase tracking-widest text-gray-400 flex items-center gap-2 mb-1\" data-kid=\"1-2-1-1-1\" data-name=\"breadcrumb navigation\">\n                    <span data-kid=\"1-2-1-1-1-1\" data-name=\"breadcrumb segment\">\n                        Operación\n                    </span>\n                    <i class=\"ti ti-chevron-right text-[10px]\" data-kid=\"1-2-1-1-1-2\" data-name=\"breadcrumb separator icon\">\n                    </i>\n                    <span class=\"text-gray-600\" data-kid=\"1-2-1-1-1-3\" data-name=\"active page segment\">\n                        Cocina\n                    </span>\n                </nav>\n                <div class=\"flex items-center gap-3\" data-kid=\"1-2-1-1-2\" data-name=\"title and status group\">\n                    <h1 class=\"text-2xl font-['Outfit'] font-bold\" data-kid=\"1-2-1-1-2-1\" data-name=\"page headline text\">\n                        Pedidos en cocina\n                    </h1>\n                    <span class=\"px-2 py-0.5 bg-green-50 text-green-600 text-[10px] font-bold uppercase tracking-wide rounded-full border border-green-100 flex items-center gap-1\" data-kid=\"1-2-1-1-2-2\" data-name=\"active status badge\">\n                        <span class=\"w-1.5 h-1.5 bg-green-500 rounded-full\" data-kid=\"1-2-1-1-2-2-1\" data-name=\"status indicator dot\">\n                        </span>\n                        Cocina activa\n                    </span>\n                </div>\n            </div>\n            <div class=\"flex items-center gap-4\" data-kid=\"1-2-1-2\" data-name=\"user tools and session group\">\n                <div class=\"bg-gray-50 px-4 py-2 rounded-xl border border-gray-100 flex items-center gap-3 cursor-pointer hover:bg-gray-100 transition-colors group\" data-kid=\"1-2-1-2-1\" data-name=\"active shift selector\">\n                    <div class=\"w-8 h-8 bg-white rounded-lg shadow-xs flex items-center justify-center text-[#F56B45] font-bold group-hover:shadow-sm transition-shadow\" data-kid=\"1-2-1-2-1-1\" data-name=\"shift identifier letter\">\n                        A\n                    </div>\n                    <div class=\"flex flex-col\" data-kid=\"1-2-1-2-1-2\" data-name=\"shift display text container\">\n                        <span class=\"text-xs font-bold\" data-kid=\"1-2-1-2-1-2-1\" data-name=\"shift name text\">\n                            Turno de almuerzo\n                        </span>\n                        <span class=\"text-[10px] text-gray-400\" data-kid=\"1-2-1-2-1-2-2\" data-name=\"shift time duration text\">\n                            12:00 - 16:30\n                        </span>\n                    </div>\n                    <i class=\"ti ti-chevron-down text-gray-400 ml-1\" data-kid=\"1-2-1-2-1-3\" data-name=\"shift selector dropdown icon\">\n                    </i>\n                </div>\n                <div class=\"w-10 h-10 bg-[#15202B] text-white rounded-full flex items-center justify-center font-['Outfit'] font-bold text-sm shadow-md\" data-kid=\"1-2-1-2-2\" data-name=\"user initials badge\">\n                    JL\n                </div>\n            </div>\n        </header>\n        <!-- Metrics Strip -->\n        <div class=\"bg-white px-8 py-4 border-b border-gray-100 flex items-center justify-between flex-shrink-0 z-0\" data-kid=\"1-2-2\" data-name=\"metrics strip\">\n            <div class=\"flex gap-12\" data-kid=\"1-2-2-1\" data-name=\"metrics container\">\n                <div class=\"flex items-center gap-3\" data-kid=\"1-2-2-1-1\" data-name=\"new orders metric card\">\n                    <div class=\"w-10 h-10 bg-[#F56B45]/5 rounded-xl flex items-center justify-center text-[#F56B45]\" data-kid=\"1-2-2-1-1-1\" data-name=\"new orders icon wrapper\">\n                        <i class=\"ti ti-star-filled text-lg\" data-kid=\"1-2-2-1-1-1-1\" data-name=\"new orders icon\">\n                        </i>\n                    </div>\n                    <div class=\"flex flex-col\" data-kid=\"1-2-2-1-1-2\" data-name=\"new orders text container\">\n                        <span class=\"text-[9px] font-bold text-gray-400 uppercase tracking-widest leading-none mb-1\" data-kid=\"1-2-2-1-1-2-1\" data-name=\"new orders label\">\n                            Nuevas\n                        </span>\n                        <span class=\"text-xl font-['Outfit'] font-bold text-[#F56B45] leading-none\" data-kid=\"1-2-2-1-1-2-2\" data-name=\"new orders count\">\n                            04\n                        </span>\n                    </div>\n                </div>\n                <div class=\"flex items-center gap-3\" data-kid=\"1-2-2-1-2\" data-name=\"in preparation metric card\">\n                    <div class=\"w-10 h-10 bg-[#15202B]/5 rounded-xl flex items-center justify-center text-[#15202B]\" data-kid=\"1-2-2-1-2-1\" data-name=\"in preparation icon wrapper\">\n                        <i class=\"ti ti-flame-filled text-lg\" data-kid=\"1-2-2-1-2-1-1\" data-name=\"in preparation icon\">\n                        </i>\n                    </div>\n                    <div class=\"flex flex-col\" data-kid=\"1-2-2-1-2-2\" data-name=\"in preparation text container\">\n                        <span class=\"text-[9px] font-bold text-gray-400 uppercase tracking-widest leading-none mb-1\" data-kid=\"1-2-2-1-2-2-1\" data-name=\"in preparation label\">\n                            En preparación\n                        </span>\n                        <span class=\"text-xl fon