      "html": "<div class=\"flex bg-[#F7F8FA] h-screen w-full font-['Atkinson_Hyperlegible'] text-[#15202B] overflow-hidden\" data-kid=\"1\" data-name=\"page layout container\">\n    <!-- Sidebar -->\n    <aside class=\"w-[88px] h-full bg-white border-r border-gray-100 flex flex-shrink-0 flex-col items-center py-6 gap-8 z-20\" data-kid=\"1-1\" data-name=\"sidebar container\">\n        <div class=\"w-12 h-12 bg-[#F56B45]/10 rounded-xl flex items-center justify-center text-[#F56B45] mb-2\" data-kid=\"1-1-1\" data-name=\"brand logo icon wrapper\">\n            <i class=\"ti ti-tools-kitchen-2 text-2xl\" data-kid=\"1-1-1-1\" data-name=\"kitchen tools icon\">\n            </i>\n        </div>\n        <nav class=\"flex flex-col gap-6 flex-1\" data-kid=\"1-1-2\" data-name=\"navigation menu\">\n            <a class=\"nav-item flex flex-col items-center gap-1 group\" data-kid=\"1-1-2-1\" data-name=\"active menu item\" href=\"#\">\n                <div class=\"w-14 h-14 bg-[#F56B45] text-white rounded-[18px] flex items-center justify-center shadow-lg shadow-[#F56B45]/20\" data-kid=\"1-1-2-1-1\" data-name=\"dashboard icon wrapper\">\n                    <i class=\"ti ti-layout-dashboard text-2xl\" data-kid=\"1-1-2-1-1-1\" data-name=\"dashboard icon\">\n                    </i>\n                </div>\n                <span class=\"text-[10px] font-bold uppercase tracking-wider text-[#F56B45]\" data-kid=\"1-1-2-1-2\" data-name=\"navigation label text\">\n                    Menú\n                </span>\n            </a>\n            <a class=\"nav-item flex flex-col items-center gap-1 group\" data-kid=\"1-1-2-2\" data-name=\"inactive menu item\" href=\"#\">\n                <div class=\"w-14 h-14 text-gray-300 rounded-[18px] flex items-center justify-center group-hover:bg-gray-50 transition-colors\" data-kid=\"1-1-2-2-1\" data-name=\"tables icon wrapper\">\n                    <i class=\"ti ti-armchair text-2xl\" data-kid=\"1-1-2-2-1-1\" data-name=\"armchair icon\">\n                    </i>\n                </div>\n                <span class=\"text-[10px] font-bold uppercase tracking-wider text-gray-400 group-hover:text-gray-600\" data-kid=\"1-1-2-2-2\" data-name=\"navigation label text\">\n                    Mesas\n                </span>\n            </a>\n            <a class=\"nav-item flex flex-col items-center gap-1 group\" data-kid=\"1-1-2-3\" data-name=\"inactive menu item\" href=\"#\">\n                <div class=\"w-14 h-14 text-gray-300 rounded-[18px] flex items-center justify-center group-hover:bg-gray-50 transition-colors\" data-kid=\"1-1-2-3-1\" data-name=\"orders icon wrapper\">\n                    <i class=\"ti ti-clipboard-list text-2xl\" data-kid=\"1-1-2-3-1-1\" data-name=\"clipboard icon\">\n                    </i>\n                </div>\n                <span class=\"text-[10px] font-bold uppercase tracking-wider text-gray-400 group-hover:text-gray-600\" data-kid=\"1-1-2-3-2\" data-name=\"navigation label text\">\n                    Comandas\n                </span>\n            </a>\n            <a class=\"nav-item flex flex-col items-center gap-1 group\" data-kid=\"1-1-2-4\" data-name=\"inactive menu item\" href=\"#\">\n                <div class=\"w-14 h-14 text-gray-300 rounded-[18px] flex items-center justify-center group-hover:bg-gray-50 transition-colors\" data-kid=\"1-1-2-4-1\" data-name=\"reports icon wrapper\">\n                    <i class=\"ti ti-chart-bar text-2xl\" data-kid=\"1-1-2-4-1-1\" data-name=\"chart bar icon\">\n                    </i>\n                </div>\n                <span class=\"text-[10px] font-bold uppercase tracking-wider text-gray-400 group-hover:text-gray-600\" data-kid=\"1-1-2-4-2\" data-name=\"navigation label text\">\n                    Reportes\n                </span>\n            </a>\n        </nav>\n        <div class=\"mt-auto flex flex-col items-center gap-6\" data-kid=\"1-1-3\" data-name=\"account footer container\">\n            <button class=\"w-12 h-12 text-gray-300 rounded-xl flex items-center justify-center hover:bg-gray-50 transition-colors\" data-kid=\"1-1-3-1\" data-name=\"settings button\">\n                <i class=\"ti ti-settings text-2xl text-gray-400\" data-kid=\"1-1-3-1-1\" data-name=\"settings icon\">\n                </i>\n            </button>\n            <div class=\"w-12 h-12 rounded-full overflow-hidden border-2 border-white shadow-sm ring-2 ring-gray-50\" data-kid=\"1-1-3-2\" data-name=\"profile image container\">\n                <img alt=\"Mozo\" class=\"w-full h-full object-cover\" data-kid=\"1-1-3-2-1\" data-name=\"profile image\" src=\"https://i.pravatar.cc/100?u=waiter12\"/>\n            </div>\n        </div>\n    </aside>\n    <!-- Main Content Area -->\n    <main class=\"flex-1 flex flex-col overflow-hidden\" data-kid=\"1-2\" data-name=\"main content area\">\n        <!-- Header -->\n        <header class=\"h-20 bg-white border-b border-gray-100 flex items-center justify-between px-8 flex-shrink-0 z-10\" data-kid=\"1-2-1\" data-name=\"header container\">\n            <div class=\"flex flex-col\" data-kid=\"1-2-1-1\" data-name=\"breadcrumb navigation container\">\n                <nav class=\"text-[11px] font-bold uppercase tracking-widest text-gray-400 flex items-center gap-2 mb-1\" data-kid=\"1-2-1-1-1\" data-name=\"breadcrumb path text\">\n                    <span data-kid=\"1-2-1-1-1-1\" data-name=\"breadcrumb root label\">\n                        Operación\n                    </span>\n                    <i class=\"ti ti-chevron-right text-[10px]\" data-kid=\"1-2-1-1-1-2\" data-name=\"chevron icon\">\n                    </i>\n                    <span class=\"text-gray-600\" data-kid=\"1-2-1-1-1-3\" data-name=\"breadcrumb current page label\">\n                        Nuevo pedido\n                    </span>\n                </nav>\n                <div class=\"flex items-center gap-3\" data-kid=\"1-2-1-1-2\" data-name=\"page title container\">\n                    <h1 class=\"text-2xl font-['Outfit'] font-bold\" data-kid=\"1-2-1-1-2-1\" data-name=\"page headline\">\n                        Menú\n                    </h1>\n                    <span class=\"px-2 py-0.5 bg-green-50 text-green-600 text-[10px] font-bold uppercase tracking-wide rounded-full border border-green-100 flex items-center gap-1\" data-kid=\"1-2-1-1-2-2\" data-name=\"service status badge\">\n                        <span class=\"w-1.5 h-1.5 bg-green-500 rounded-full\" data-kid=\"1-2-1-1-2-2-1\" data-name=\"active status dot\">\n                        </span>\n                        Servicio activo\n                    </span>\n                </div>\n            </div>\n            <div class=\"flex items-center gap-4\" data-kid=\"1-2-1-2\" data-name=\"header user actions container\">\n                <div class=\"bg-gray-50 px-4 py-2 rounded-xl border border-gray-100 flex items-center gap-3 cursor-pointer hover:bg-gray-100 transition-colors group\" data-kid=\"1-2-1-2-1\" data-name=\"current table selector button\">\n                    <div class=\"w-8 h-8 bg-white rounded-lg shadow-xs flex items-center justify-center text-[#F56B45] font-bold group-hover:shadow-sm transition-shadow\" data-kid=\"1-2-1-2-1-1\" data-name=\"table number indicator\">\n                        12\n                    </div>\n                    <div class=\"flex flex-col\" data-kid=\"1-2-1-2-1-2\" data-name=\"table status text container\">\n                        <span class=\"text-xs font-bold\" data-kid=\"1-2-1-2-1-2-1\" data-name=\"table identifier text\">\n                            Mesa 12\n                        </span>\n                        <span class=\"text-[10px] text-gray-400\" data-kid=\"1-2-1-2-1-2-2\" data-name=\"guests count text\">\n                            3 personas\n                        </span>\n                    </div>\n                    <i class=\"ti ti-chevron-down text-gray-400 ml-1\" data-kid=\"1-2-1-2-1-3\" data-name=\"chevron dropdown icon\">\n                    </i>\n                </div>\n                <div class=\"w-10 h-10 bg-[#15202B] text-white rounded-full flex items-center justify-center font-['Outfit'] font-bold text-sm shadow-md\" data-kid=\"1-2-1-2-2\" data-name=\"user initials badge\">\n                    JL\n                </div>\n            </div>\n        </header>\n        <!-- Menu Content -->\n        <div class=\"flex-1 overflow-y-auto custom-scrollbar p-8\" data-kid=\"1-2-2\" data-name=\"menu items scrollable container\">\n            <div class=\"max-w-4xl mx-auto\" data-kid=\"1-2-2-1\" data-name=\"menu content wrapper\">\n                <!-- Search & Filters -->\n                <div class=\"sticky top-0 z-10 bg-[#F7F8FA]/90 backdrop-blur-md pb-6 pt-2\" data-kid=\"1-2-2-1-1\" data-name=\"search and filters sticky header\">\n                    <div class=\"relative mb-6\" data-kid=\"1-2-2-1-1-1\" data-name=\"search input container\">\n                        <i class=\"ti ti-search absolute left-5 top-1/2 -translate-y-1/2 text-gray-400 text-xl\" data-kid=\"1-2-2-1-1-1-1\" data-name=\"search icon\">\n                        </i>\n                        <input class=\"w-full bg-white border border-gray-100 rounded-[18px] py-4 pl-14 pr-24 text-sm focus:outline-none focus:ring-4 focus:ring-[#F56B45]/10 focus:border-[#F56B45]/30 transition-all shadow-sm\" data-kid=\"1-2-2-1-1-1-2\" data-name=\"search input field\" placeholder=\"Buscar plato o ingrediente...\" type=\"text\"/>\n                        <div class=\"absolute right-5 top-1/2 -translate-y-1/2 px-2 py-1 bg-gray-50 border border-gray-200 rounded text-[10px] font-mono text-gray-400\" data-kid=\"1-2-2-1-1-1-3\" data-name=\"shortcut key hint\">\n                            ⌘ K\n                        </div>\n                    </div>\n                    <div class=\"flex gap-3 overflow-x-auto pb-2 scrollbar-hide\" data-kid=\"1-2-2-1-1-2\" data-name=\"filter category buttons container\">\n                        <button class=\"px-6 py-3 bg-[#F56B45] text-white rounded-xl font-bold text-sm shadow-lg shadow-[#F56B45]/20 shrink-0\" data-kid=\"1-2-2-1-1-2-1\" data-name=\"all categories button\">\n                            Todos\n                            <span class=\"opacity-70 ml-1\" data-kid=\"1-2-2-1-1-2-1-1\" data-name=\"total items count\">\n                                24\n                            </span>\n                        </button>\n                        <button class=\"px-6 py-3 bg-white text-gray-500 hover:text-gray-700 rounded-xl font-bold text-sm border border-gray-100 shrink-0 transition-colors hover:border-[#F56B45]/30\" data-kid=\"1-2-2-1-1-2-2\" data-name=\"entree category button\">\n                            Entradas\n                        </button>\n                        <button class=\"px-6 py-3 bg-white text-gray-500 hover:text-gray-700 rounded-xl font-bold text-sm border border-gray-100 shrink-0 transition-colors hover:border-[#F56B45]/30\" data-kid=\"1-2-2-1-1-2-3\" data-name=\"main course category button\">\n                            Principales\n                        </button>\n                        <button class=\"px-6 py-3 bg-white text-gray-500 hover:text-gray-700 rounded-xl font-bold text-sm border border-gray-100 shrink-0 transition-colors hover:border-[#F56B45]/30\" data-kid=\"1-2-2-1-1-2-4\" data-name=\"burger category button\">\n                            Hamburguesas\n                        </button>\n                        <button class=\"px-6 py-3 bg-white text-gray-500 hover:text-gray-700 rounded-xl font-bold text-sm border border-gray-100 shrink-0 transition-colors hover:border-[#F56B45]/30\" data-kid=\"1-2-2-1-1-2-5\" data-name=\"drink category button\">\n                            Bebidas\n                        </button>\n                        <button class=\"px-6 py-3 bg-white text-gray-500 hover:text-gray-700 rounded-xl font-bold text-sm border border-gray-100 shrink-0 transition-colors hover:border-[#F56B45]/30\" data-kid=\"1-2-2-1-1-2-6\" data-name=\"dessert category button\">\n                            Postres\n                        </button>\n                    </div>\n                </div>\n                <!-- Grid -->\n                <div class=\"grid grid-cols-2 gap-6 pb-12\" data-kid=\"1-2-2-1-2\" data-name=\"dish grid container\">\n                    <!-- Card 1 -->\n                    <div class=\"dish-card bg-white rounded-[20px] border border-gray-100 overflow-hidden group hover:shadow-xl hover:shadow-gray-200/40 hover:transition-all hover:duration-300\" data-kid=\"1-2-2-1-2-1\" data-name=\"first dish card\">\n                        <div class=\"relative h-44 overflow-hidden\" data-kid=\"1-2-2-1-2-1-1\" data-name=\"dish image container\">\n                            <img alt=\"Ensalada fresca, Chris Tweten en Unsplash\" class=\"w-full h-full object-cover transition-transform duration-700 group-hover:scale-105\" data-kid=\"1-2-2-1-2-1-1-1\" data-name=\"dish thumbnail image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1550304943-4f24f54ddde9?auto=format&w=720&q=80&fit=crop\"/>\n                            <div class=\"absolute top-4 left-4 px-3 py-1.5 bg-[#F56B45] text-white text-[10px] font-bold uppercase tracking-wider rounded-lg shadow-lg\" data-kid=\"1-2-2-1-2-1-1-2\" data-name=\"popular badge\">\n                                Más pedido\n                            </div>\n                        </div>\n                        <div class=\"p-6 flex justify-between items-end\" data-kid=\"1-2-2-1-2-1-2\" data-name=\"dish details wrapper\">\n                            <div class=\"flex-1\" data-kid=\"1-2-2-1-2-1-2-1\" data-name=\"dish info container\">\n                                <h3 class=\"font-['Outfit'] font-bold text-lg mb-1 leading-tight\" data-kid=\"1-2-2-1-2-1-2-1-1\" data-name=\"dish name\">\n                                    Ceviche clásico\n                                </h3>\n                                <p class=\"text-xs text-gray-400 line-clamp-1 mb-3 pr-4\" data-kid=\"1-2-2-1-2-1-2-1-2\" data-name=\"dish description\">\n                                    Pescado del día, limón de pica, cebolla roja y camote glaseado.\n                                </p>\n                                <span class=\"text-[#15202B] font-bold text-xl font-['Outfit']\" data-kid=\"1-2-2-1-2-1-2-1-3\" data-name=\"dish price\">\n                                    S/ 32.00\n                                </span>\n                            </div>\n                            <button class=\"w-12 h-12 bg-gray-50 text-[#15202B] rounded-xl flex items-center justify-center hover:bg-[#F56B45] hover:text-white transition-all transform active:scale-95 border border-gray-100 shadow-xs\" data-kid=\"1-2-2-1-2-1-2-2\" data-name=\"add to order button\">\n                                <i class=\"ti ti-plus text-xl\" data-kid=\"1-2-2-1-2-1-2-2-1\" data-name=\"plus icon\">\n                                </i>\n                            </button>\n                        </div>\n                    </div>\n                    <!-- Card 2 -->\n                    <div class=\"dish-card bg-white rounded-[20px] border border-gray-100 overflow-hidden group hover:shadow-xl hover:shadow-gray-200/40 hover:transition-all hover:duration-300\" data-kid=\"1-2-2-1-2-2\" data-name=\"second dish card\">\n                        <div class=\"relative h-44 overflow-hidden\" data-kid=\"1-2-2-1-2-2-1\" data-name=\"dish image container\">\n                            <img alt=\"Salmón emplatado, Sara Nichols en Unsplash\" class=\"w-full h-full object-cover transition-transform duration-700 group-hover:scale-105\" data-kid=\"1-2-2-1-2-2-1-1\" data-name=\"dish thumbnail image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1712334562767-5d366d0c40d9?auto=format&w=720&q=80&fit=crop\"/>\n                        </div>\n                        <div class=\"p-6 flex justify-between items-end\" data-kid=\"1-2-2-1-2-2-2\" data-name=\"dish details wrapper\">\n                            <div class=\"flex-1\" data-kid=\"1-2-2-1-2-2-2-1\" data-name=\"dish info container\">\n                                <h3 class=\"font-['Outfit'] font-bold text-lg mb-1 leading-tight\" data-kid=\"1-2-2-1-2-2-2-1-1\" data-name=\"dish name\">\n                                    Lomo saltado\n                                </h3>\n                                <p class=\"text-xs text-gray-400 line-clamp-1 mb-3 pr-4\" data-kid=\"1-2-2-1-2-2-2-1-2\" data-name=\"dish description\">\n                                    Finas tiras de lomo fino, cebolla roja, tomate y papas amarillas.\n                                </p>\n                                <span class=\"text-[#15202B] font-bold text-xl font-['Outfit']\" data-kid=\"1-2-2-1-2-2-2-1-3\" data-name=\"dish price\">\n                                    S/ 45.00\n                                </span>\n                            </div>\n                            <button class=\"w-12 h-12 bg-gray-50 text-[#15202B] rounded-xl flex items-center justify-center hover:bg-[#F56B45] hover:text-white transition-all transform active:scale-95 border border-gray-100 shadow-xs\" data-kid=\"1-2-2-1-2-2-2-2\" data-name=\"add to order button\">\n                                <i class=\"ti ti-plus text-xl\" data-kid=\"1-2-2-1-2-2-2-2-1\" data-name=\"plus icon\">\n                                </i>\n                            </button>\n                        </div>\n                    </div>\n                    <!-- Card 3 -->\n                    <div class=\"dish-card bg-white rounded-[20px] border border-gray-100 overflow-hidden group hover:shadow-xl hover:shadow-gray-200/40 hover:transition-all hover:duration-300\" data-kid=\"1-2-2-1-2-3\" data-name=\"third dish card\">\n                        <div class=\"relative h-44 overflow-hidden\" data-kid=\"1-2-2-1-2-3-1\" data-name=\"dish image container\">\