label\">\n                        Subtotal\n                    </span>\n                    <span class=\"text-gray-500\" data-kid=\"1-3-3-1-1-2\" data-name=\"subtotal amount\">\n                        S/ 63.50\n                    </span>\n                </div>\n                <div class=\"flex justify-between text-sm text-gray-400 font-bold\" data-kid=\"1-3-3-1-2\" data-name=\"tax row\">\n                    <span data-kid=\"1-3-3-1-2-1\" data-name=\"tax label\">\n                        IGV (18%)\n                    </span>\n                    <span class=\"text-gray-500\" data-kid=\"1-3-3-1-2-2\" data-name=\"tax amount\">\n                        S/ 11.43\n                    </span>\n                </div>\n                <div class=\"flex justify-between text-2xl font-['Outfit'] font-bold pt-3 border-t border-gray-50\" data-kid=\"1-3-3-1-3\" data-name=\"total row\">\n                    <span data-kid=\"1-3-3-1-3-1\" data-name=\"total label\">\n                        Total\n                    </span>\n                    <span class=\"text-[#15202B]\" data-kid=\"1-3-3-1-3-2\" data-name=\"total amount\">\n                        S/ 74.93\n                    </span>\n                </div>\n            </div>\n            <div class=\"space-y-3\" data-kid=\"1-3-3-2\" data-name=\"action buttons container\">\n                <button class=\"w-full bg-[#F56B45] text-white py-4.5 rounded-[18px] font-bold text-sm shadow-lg shadow-[#F56B45]/25 hover:bg-[#e45b36] hover:shadow-xl hover:shadow-[#F56B45]/30 transition-all transform active:scale-[0.98] cursor-pointer\" data-kid=\"1-3-3-2-1\" data-name=\"submit to kitchen button\">\n                    Enviar a cocina\n                </button>\n                <button class=\"w-full bg-white text-[#15202B] py-4 rounded-[18px] font-bold text-sm border border-gray-200 hover:bg-gray-50 hover:border-gray-300 transition-all cursor-pointer\" data-kid=\"1-3-3-2-2\" data-name=\"save as pending button\">\n                    Guardar pendiente\n                </button>\n            </div>\n            <div class=\"flex items-center justify-center gap-2 mt-4 text-[10px] text-gray-300 italic font-medium\" data-kid=\"1-3-3-3\" data-name=\"update status indicator\">\n                <span class=\"w-1 h-1 bg-gray-200 rounded-full\" data-kid=\"1-3-3-3-1\" data-name=\"indicator dot\">\n                </span>\n                Última actualización hace 2 min\n            </div>\n        </div>\n    </aside>\n</div>\n<style>\n    @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700&family=Atkinson+Hyperlegible:ital,wght@0,400;0,700;1,400&display=swap');\n    @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n    .custom-scrollbar::-webkit-scrollbar {\n        width: 4px;\n    }\n    .custom-scrollbar::-webkit-scrollbar-track {\n        background: transparent;\n    }\n    .custom-scrollbar::-webkit-scrollbar-thumb {\n        background: #E5E7EB;\n        border-radius: 10px;\n    }\n    .custom-scrollbar::-webkit-scrollbar-thumb:hover {\n        background: #D1D5DB;\n    }\n    .scrollbar-hide::-webkit-scrollbar {\n        display: none;\n    }\n    .scrollbar-hide {\n        -ms-overflow-style: none;\n        scrollbar-width: none;\n    }\n\n    body {\n        margin: 0;\n        padding: 0;\n        background-color: #F7F8FA;\n    }\n    \n    /* Animation initial states handled by GSAP */\n</style>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script>\n    document.addEventListener('DOMContentLoaded', () => {\n        // Entrance animations\n        gsap.from('.nav-item', {\n            x: -20,\n            opacity: 0,\n            duration: 0.6,\n            stagger: 0.1,\n            ease: 'back.out(1.7)'\n        });\n\n        gsap.from('.dish-card', {\n            y: 30,\n            opacity: 0,\n            duration: 0.8,\n            stagger: 0.08,\n            ease: 'power3.out',\n            delay: 0.2\n        });\n\n        gsap.from('.order-item', {\n            x: 20,\n            opacity: 0,\n            duration: 0.6,\n            stagger: 0.1,\n            ease: 'power2.out',\n            delay: 0.5\n        });\n\n        // Hover effects for sidebar icons\n        const navItems = document.querySelectorAll('.nav-item div');\n        navItems.forEach(item => {\n            item.addEventListener('mouseenter', () => {\n                if (!item.classList.contains('bg-[#F56B45]')) {\n                    gsap.to(item, { scale: 1.1, duration: 0.3, ease: 'power2.out' });\n                }\n            });\n            item.addEventListener('mouseleave', () => {\n                if (!item.classList.contains('bg-[#F56B45]')) {\n                    gsap.to(item, { scale: 1, duration: 0.3, ease: 'power2.out' });\n                }\n            });\n        });\n\n        // Plus button feedback\n        const plusButtons = document.querySelectorAll('.dish-card button');\n        plusButtons.forEach(btn => {\n            btn.addEventListener('click', () => {\n                gsap.to(btn, { scale: 0.9, duration: 0.1, yoyo: true, repeat: 1 });\n            });\n        });\n    });\n</script>\n",
