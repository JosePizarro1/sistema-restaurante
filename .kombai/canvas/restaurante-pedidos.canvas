me=\"reject button\">\n                                Rechazar\n                            </button>\n                            <button class=\"flex-2 bg-green-500 text-white py-3 rounded-xl text-xs font-bold shadow-lg shadow-green-500/20 hover:bg-green-600 transition-colors\" data-kid=\"1-2-3-2-1-3-3-2\" data-name=\"complete order button\">\n                                Pedido listo\n                            </button>\n                        </div>\n                    </div>\n                    <!-- Comanda 4: #1045 -->\n                    <div class=\"comanda-card bg-white rounded-[20px] border border-gray-100 shadow-sm hover:shadow-md transition-shadow p-6 flex flex-col gap-4\" data-kid=\"1-2-3-2-1-4\" data-name=\"in preparation command card #1045\">\n                        <div class=\"flex items-start justify-between\" data-kid=\"1-2-3-2-1-4-1\" data-name=\"card header\">\n                            <div class=\"flex flex-col gap-1\" data-kid=\"1-2-3-2-1-4-1-1\" data-name=\"card title and status group\">\n                                <div class=\"flex items-center gap-2\" data-kid=\"1-2-3-2-1-4-1-1-1\" data-name=\"title group\">\n                                    <h3 class=\"font-['Outfit'] font-bold text-lg\" data-kid=\"1-2-3-2-1-4-1-1-1-1\" data-name=\"command number title\">\n                                        Comanda #1045\n                                    </h3>\n                                    <span class=\"px-2 py-0.5 bg-blue-50 text-blue-600 text-[10px] font-bold uppercase rounded-md\" data-kid=\"1-2-3-2-1-4-1-1-1-2\" data-name=\"status badge\">\n                                        En preparación\n                                    </span>\n                                </div>\n                                <div class=\"flex items-center gap-4 text-xs text-gray-400 font-bold\" data-kid=\"1-2-3-2-1-4-1-1-2\" data-name=\"card metadata group\">\n                                    <span class=\"flex items-center gap-1\" data-kid=\"1-2-3-2-1-4-1-1-2-1\" data-name=\"table number metadata\">\n                                        <i class=\"ti ti-armchair\" data-kid=\"1-2-3-2-1-4-1-1-2-1-1\" data-name=\"table icon\">\n                                        </i>\n                                        Mesa 15\n                                    </span>\n                                    <span class=\"flex items-center gap-1\" data-kid=\"1-2-3-2-1-4-1-1-2-2\" data-name=\"time elapsed metadata\">\n                                        <i class=\"ti ti-clock\" data-kid=\"1-2-3-2-1-4-1-1-2-2-1\" data-name=\"clock icon\">\n                                        </i>\n                                        Hace 11 min\n                                    </span>\n                                </div>\n                            </div>\n                            <div class=\"w-8 h-8 bg-gray-50 text-[#15202B] rounded-full flex items-center justify-center text-[10px] font-bold border border-gray-100\" data-kid=\"1-2-3-2-1-4-1-2\" data-name=\"waiter initials badge\">\n                                LC\n                            </div>\n                        </div>\n                        <div class=\"flex-1 space-y-4 py-2\" data-kid=\"1-2-3-2-1-4-2\" data-name=\"card items list\">\n                            <div class=\"flex items-start gap-4\" data-kid=\"1-2-3-2-1-4-2-1\" data-name=\"standard item container\">\n                                <div class=\"w-8 h-8 bg-[#F7F8FA] rounded-lg flex items-center justify-center text-sm font-bold text-[#15202B]\" data-kid=\"1-2-3-2-1-4-2-1-1\" data-name=\"quantity badge\">\n                                    1×\n                                </div>\n                                <div class=\"flex-1 pt-1\" data-kid=\"1-2-3-2-1-4-2-1-2\" data-name=\"item details container\">\n                                    <h4 class=\"text-sm font-bold\" data-kid=\"1-2-3-2-1-4-2-1-2-1\" data-name=\"item name\">\n                                        Salmón a la parrilla\n                                    </h4>\n                                </div>\n                            </div>\n                            <div class=\"flex items-start gap-4\" data-kid=\"1-2-3-2-1-4-2-2\" data-name=\"standard item container\">\n                                <div class=\"w-8 h-8 bg-[#F7F8FA] rounded-lg flex items-center justify-center text-sm font-bold text-[#15202B]\" data-kid=\"1-2-3-2-1-4-2-2-1\" data-name=\"quantity badge\">\n                                    2×\n                                </div>\n                                <div class=\"flex-1 pt-1\" data-kid=\"1-2-3-2-1-4-2-2-2\" data-name=\"item details container\">\n                                    <h4 class=\"text-sm font-bold\" data-kid=\"1-2-3-2-1-4-2-2-2-1\" data-name=\"item name\">\n                                        Chicha morada\n                                    </h4>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"pt-4 border-t border-gray-50 flex gap-3\" data-kid=\"1-2-3-2-1-4-3\" data-name=\"card actions group\">\n                            <button class=\"flex-1 border border-red-500 text-red-600 py-3 rounded-xl text-xs font-bold hover:bg-red-50 transition-colors\" data-kid=\"1-2-3-2-1-4-3-1\" data-name=\"reject button\">\n                                Rechazar\n                            </button>\n                            <button class=\"flex-2 bg-green-500 text-white py-3 rounded-xl text-xs font-bold shadow-lg shadow-green-500/20 hover:bg-green-600 transition-colors\" data-kid=\"1-2-3-2-1-4-3-2\" data-name=\"complete order button\">\n                                Pedido listo\n                            </button>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"flex items-center gap-2 text-[10px] text-gray-400 font-bold uppercase tracking-widest mt-4 pb-8\" data-kid=\"1-2-3-2-2\" data-name=\"grid footer info text\">\n                    <i class=\"ti ti-info-circle text-sm text-[#F56B45]\" data-kid=\"1-2-3-2-2-1\" data-name=\"info icon\">\n                    </i>\n                    Las comandas nuevas se resaltan automáticamente.\n                </div>\n            </div>\n        </div>\n    </main>\n</div>\n<style>\n    @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700&family=Atkinson+Hyperlegible:ital,wght@0,400;0,700;1,400&display=swap');\n    @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n    .custom-scrollbar::-webkit-scrollbar {\n        width: 6px;\n    }\n    .custom-scrollbar::-webkit-scrollbar-track {\n        background: transparent;\n    }\n    .custom-scrollbar::-webkit-scrollbar-thumb {\n        background: #E5E7EB;\n        border-radius: 10px;\n    }\n    .custom-scrollbar::-webkit-scrollbar-thumb:hover {\n        background: #D1D5DB;\n    }\n\n    body {\n        margin: 0;\n        padding: 0;\n        background-color: #F7F8FA;\n    }\n\n    .comanda-card {\n        will-change: transform, opacity;\n    }\n</style>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script>\n    document.addEventListener('DOMContentLoaded', () => {\n        gsap.from('.nav-item', {\n            x: -20,\n            opacity: 0,\n            duration: 0.6,\n            stagger: 0.1,\n            ease: 'back.out(1.7)'\n        });\n\n        gsap.from('header, .bg-white.px-8.py-4', {\n            y: -20,\n            opacity: 0,\n            duration: 0.8,\n            ease: 'power3.out'\n        });\n\n        gsap.from('.comanda-card', {\n            y: 40,\n            opacity: 0,\n            duration: 0.7,\n            stagger: 0.15,\n            ease: 'power4.out',\n            delay: 0.3\n        });\n    });\n</script>\n",
      "comments": [],
      "created": "2026-07-27T02:40:52.672750+00:00",
      "modified": "2026-07-27T02:40:52.672750+00:00",
      "id": "var_7b5f9deb1a12"
    },
    "var_cd536be105e5": {
      "type": "variant",
      "label": "Login — mesa",
      "parentId": "var_19eded66d3b7",
      "themeId": null,
      "rect": {
        "x": 2760,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "\n        <div class=\"flex w-full h-screen overflow-hidden font-['Atkinson_Hyperlegible'] text-[#15202B]\" data-kid=\"1\" data-name=\"page layout container\">\n            <!-- Left Section: Branding and Message -->\n            <section class=\"relative w-[42%] bg-[#F56B45] flex flex-col justify-between p-20 text-white overflow-hidden shrink-0\" data-kid=\"1-1\" data-name=\"branding and message section\">\n                <!-- Decorative Shapes -->\n                <div class=\"absolute -top-20 -right-20 w-80 h-80 bg-white/5 rounded-full blur-3xl\" data-kid=\"1-1-1\" data-name=\"top decorative blur orb\">\n                </div>\n                <div class=\"absolute -bottom-20 -left-20 w-96 h-96 bg-black/5 rounded-full blur-3xl\" data-kid=\"1-1-2\" data-name=\"bottom decorative blur orb\">\n                </div>\n                <div class=\"absolute top-1/3 -right-12 w-48 h-48 border-8 border-white/5 rounded-[48px] rotate-12\" data-kid=\"1-1-3\" data-name=\"decorative right border element\">\n                </div>\n                <div class=\"absolute top-1/2 left-0 w-24 h-24 border-2 border-white/10 rounded-full -translate-x-12\" data-kid=\"1-1-4\" data-name=\"decorative left circle element\">\n                </div>\n                <div class=\"relative z-10\" data-kid=\"1-1-5\" data-name=\"text content container\">\n                    <!-- Logo Container -->\n                    <div class=\"animate-left-brand flex items-center gap-4 mb-24\" data-kid=\"1-1-5-1\" data-name=\"logo container\">\n                        <div class=\"w-16 h-16 bg-white rounded-[20px] flex items-center justify-center shadow-xl shadow-black/5\" data-kid=\"1-1-5-1-1\" data-name=\"logo icon background\">\n                            <i class=\"ti ti-tools-kitchen-2 text-[#F56B45] text-3xl\" data-kid=\"1-1-5-1-1-1\" data-name=\"kitchen tools icon\">\n                            </i>\n                        </div>\n                        <span class=\"font-['Outfit'] font-bold text-4xl tracking-tight\" data-kid=\"1-1-5-1-2\" data-name=\"logo text\">\n                            mesa\n                        </span>\n                    </div>\n                    <!-- Content Text -->\n                    <div class=\"max-w-md\" data-kid=\"1-1-5-2\" data-name=\"hero text content block\">\n                        <h1 class=\"animate-left-title font-['Outfit'] font-bold text-6xl leading-[1.05] mb-8\" data-kid=\"1-1-5-2-1\" data-name=\"hero headline text\">\n                            Que el servicio siga fluyendo.\n                        </h1>\n                        <p class=\"animate-left-subtitle text-xl text-white/80 leading-relaxed font-normal\" data-kid=\"1-1-5-2-2\" data-name=\"hero subtitle text\">\n                            Todo lo que tu equipo necesita para recibir, preparar y entregar pedidos sin perder el ritmo.\n                        </p>\n                    </div>\n                </div>\n                <!-- Footer Info Block -->\n                <div class=\"animate-left-status relative z-10 flex items-center justify-between bg-black/10 backdrop-blur-xl border border-white/10 p-5 rounded-[22px] max-w-sm\" data-kid=\"1-1-6\" data-name=\"status info block\">\n                    <div class=\"flex items-center gap-4\" data-kid=\"1-1-6-1\" data-name=\"status icon and text group\">\n                        <div class=\"w-12 h-12 bg-white/10 rounded-xl flex items-center justify-center\" data-kid=\"1-1-6-1-1\" data-name=\"status icon container\">\n                            <i class=\"ti ti-tools-kitchen-2 text-2xl text-white\" data-kid=\"1-1-6-1-1-1\" data-name=\"status kitchen tools icon\">\n                            </i>\n                        </div>\n                        <div data-kid=\"1-1-6-1-2\" data-name=\"status text container\">\n                            <div class=\"flex items-center gap-2 mb-0.5\" data-kid=\"1-1-6-1-2-1\" data-name=\"status indicator row\">\n                                <span class=\"w-2.5 h-2.5 bg-[#4ADE80] rounded-full shadow-[0_0_8px_rgba(74,222,128,0.5)]\" data-kid=\"1-1-6-1-2-1-1\" data-name=\"active status dot\">\n                                </span>\n                                <span class=\"text-[11px] font-bold uppercase tracking-wider text-white\" data-kid=\"1-1-6-1-2-1-2\" data-name=\"active status text\">\n                                    Servicio activo\n                                </span>\n                            </div>\n                            <span class=\"text-sm text-white/60\" data-kid=\"1-1-6-1-2-2\" data-name=\"current time text\">\n                                Hoy · 12:45\n                            </span>\n                        </div>\n                    </div>\n                    <div class=\"px-2\" data-kid=\"1-1-6-2\" data-name=\"status chevron container\">\n                        <i class=\"ti ti-chevron-right text-white/30\" data-kid=\"1-1-6-2-1\" data-name=\"chevron right icon\">\n                        </i>\n                    </div>\n                </div>\n            </section>\n            <!-- Right Section: Login Form -->\n            <section class=\"flex-1 bg-white flex flex-col items-center justify-center p-12 relative overflow-hidden\" data-kid=\"1-2\" data-name=\"login form section\">\n                <!-- Background pattern -->\n                <div class=\"absolute inset-0 opacity-[0.03] pointer-events-none\" data-kid=\"1-2-1\" data-name=\"background pattern container\" style=\"background-image: radial-gradient(#15202B 1px, transparent 0); background-size: 40px 40px;\">\n                </div>\n                <!-- Badge -->\n                <div class=\"animate-badge mb-10 flex items-center gap-2 px-5 py-2 bg-[#F7F8FA] border border-[#F0F1F3] rounded-full text-[11px] font-bold uppercase tracking-[0.15em] text-[#15202B]/50 shadow-xs\" data-kid=\"1-2-2\" data-name=\"panel badge\">\n                    <span class=\"w-2 h-2 bg-[#F56B45] rounded-full\" data-kid=\"1-2-2-1\" data-name=\"badge dot\">\n                    </span>\n                    Panel operativo\n                </div>\n                <!-- Login Card -->\n                <div class=\"animate-card w-full max-w-[420px] bg-white relative z-10\" data-kid=\"1-2-3\" data-name=\"login card container\">\n                    <div class=\"mb-10 text-center\" data-kid=\"1-2-3-1\" data-name=\"login card header\">\n                        <h2 class=\"font-['Outfit'] font-bold text-4xl mb-3 text-[#15202B]\" data-kid=\"1-2-3-1-1\" data-name=\"login headline\">\n                            Bienvenido de vuelta\n                        </h2>\n                        <p class=\"text-gray-400 text-lg\" data-kid=\"1-2-3-1-2\" data-name=\"login subtitle\">\n                            Ingresa tus datos para continuar.\n                        </p>\n                    </div>\n                    <form class=\"space-y-6\" data-kid=\"1-2-3-2\" data-name=\"login form\" onsubmit=\"event.preventDefault();\">\n                        <!-- Email Field -->\n                        <div class=\"animate-form-group\" data-kid=\"1-2-3-2-1\" data-name=\"email input group\">\n                            <label class=\"block text-[13px] font-bold mb-2.5 text-[#15202B]/60 uppercase tracking-wider\" data-kid=\"1-2-3-2-1-1\" data-name=\"email label\" for=\"email\">\n                                Correo electrónico\n                            </label>\n                            <div class=\"relative\" data-kid=\"1-2-3-2-1-2\" data-name=\"email input wrapper\">\n                                <i class=\"ti ti-mail absolute left-5 top-1/2 -translate-y-1/2 text-gray-400 text-xl pointer-events-none\" data-kid=\"1-2-3-2-1-2-1\" data-name=\"email icon\">\n                                </i>\n                                <input class=\"login-input w-full h-15 pl-14 pr-6 bg-[#F7F8FA] border border-[#F0F1F3] rounded-[20px] focus:outline-hidden font-medium placeholder:text-gray-300\" data-kid=\"1-2-3-2-1-2-2\" data-name=\"email input field\" id=\"email\" placeholder=\"mozo@restaurante.com\" type=\"email\"/>\n                            </div>\n                        </div>\n                        <!-- Password Field -->\n                        <div class=\"animate-form-group\" data-kid=\"1-2-3-2-2\" data-name=\"password input group\">\n                            <div class=\"flex justify-between items-center mb-2.5\" data-kid=\"1-2-3-2-2-1\" data-name=\"password header\">\n                                <label class=\"block text-[13px] font-bold text-[#15202B]/60 uppercase tracking-wider\" data-kid=\"1-2-3-2-2-1-1\" data-name=\"password label\" for=\"password\">\n                                    Contraseña\n                                </label>\n                                <a class=\"text-xs font-bold text-[#F56B45] hover:text-[#e45b36]\" data-kid=\"1-2-3-2-2-1-2\" data-name=\"forgot password link\" href=\"#\">\n                                    ¿Olvidaste tu contraseña?\n                                </a>\n                            </div>\n                            <div class=\"relative\" data-kid=\"1-2-3-2-2-2\" data-name=\"password input wrapper\">\n                                <i class=\"ti ti-lock absolute left-5 top-1/2 -translate-y-1/2 text-gray-400 text-xl pointer-events-none\" data-kid=\"1-2-3-2-2-2-1\" data-name=\"password icon\">\n                                </i>\n                                <input class=\"login-input w-full h-15 pl-14 pr-14 bg-[#F7F8FA] border border-[#F0F1F3] rounded-[20px] focus:outline-hidden font-medium placeholder:text-gray-300\" data-kid=\"1-2-3-2-2-2-2\" data-name=\"password input field\" id=\"password\" placeholder=\"••••••••\" type=\"password\"/>\n                                <button class=\"absolute right-5 top-1/2 -translate-y-1/2 text-gray-400 hover:text-[#15202B]\" data-kid=\"1-2-3-2-2-2-3\" data-name=\"password visibility toggle button\" type=\"button\">\n                                    <i class=\"ti ti-eye\" data-kid=\"1-2-3-2-2-2-3-1\" data-name=\"eye icon\">\n                                    </i>\n                                </button>\n                            </div>\n                        </div>\n                        <!-- Remember Me -->\n                        <div class=\"animate-form-group\" data-kid=\"1-2-3-2-3\" data-name=\"remember me group\">\n                            <label class=\"flex items-center gap-3 cursor-pointer select-none group\" data-kid=\"1-2-3-2-3-1\" data-name=\"remember me checkbox label\">\n                                <div class=\"relative flex items-center\" data-kid=\"1-2-3-2-3-1-1\" data-name=\"checkbox wrapper\">\n                                    <input class=\"peer appearance-none w-6 h-6 border-2 border-[#F0F1F3] rounded-lg checked:bg-[#F56B45] checked:border-[#F56B45] cursor-pointer\" data-kid=\"1-2-3-2-3-1-1-1\" data-name=\"remember me checkbox\" type=\"checkbox\"/>\n                                    <i class=\"ti ti-check absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 text-white text-sm opacity-0 peer-checked:opacity-100 pointer-events-none\" data-kid=\"1-2-3-2-3-1-1-2\" data-name=\"checkmark icon\">\n                                    </i>\n                                </div>\n                                <span class=\"text-sm font-bold text-gray-500 group-hover:text-[#15202B]\" data-kid=\"1-2-3-2-3-1-2\" data-name=\"remember me text\">\n                                    Recordarme en este dispositivo\n                                </span>\n                            </label>\n                        </div>\n                        <!-- Login Button -->\n                        <div class=\"animate-form-group\" data-kid=\"1-2-3-2-4\" data-name=\"login button container\">\n                            <button class=\"login-button-primary w-full h-16 bg-[#F56B45] text-white rounded-[20px] font-bold text-lg shadow-lg shadow-[#F56B45]/20 hover:bg-[#e45b36] cursor-pointer flex items-center justify-center gap-2 group\" data-kid=\"1-2-3-2-4-1\" data-name=\"login submit button\">\n                                <span data-kid=\"1-2-3-2-4-1-1\" data-name=\"submit button text\">\n                                    Iniciar sesión\n                                </span>\n                                <i class=\"ti ti-arrow-right text-xl transition-transform group-hover:translate-x-1\" data-kid=\"1-2-3-2-4-1-2\" data-name=\"arrow right icon\">\n                                </i>\n                            </button>\n                        </div>\n                    </form>\n                    <!-- Divider -->\n                    <div class=\"animate-form-group relative my-10 flex items-center justify-center\" data-kid=\"1-2-3-3\" data-name=\"form divider\">\n                        <div class=\"absolute inset-0 flex items-center\" data-kid=\"1-2-3-3-1\" data-name=\"divider line container\">\n                            <div class=\"w-full border-t-2 border-[#F0F1F3]\" data-kid=\"1-2-3-3-1-1\" data-name=\"divider line\">\n                            </div>\n                        </div>\n                        <span class=\"relative px-5 bg-white text-[11px] font-bold uppercase tracking-[0.2em] text-gray-300\" data-kid=\"1-2-3-3-2\" data-name=\"divider text\">\n                            o continuar con\n                        </span>\n                    </div>\n                    <!-- Google Login -->\n                    <div class=\"animate-form-group\" data-kid=\"1-2-3-4\" data-name=\"google login container\">\n                        <button class=\"login-button-secondary w-full h-15 bg-white border-2 border-[#F0F1F3] rounded-[20px] font-bold text-[#15202B] hover:bg-[#F7F8FA] flex items-center justify-center gap-3 cursor-pointer\" data-kid=\"1-2-3-4-1\" data-name=\"google login button\">\n                            <i class=\"ti ti-brand-google text-2xl\" data-kid=\"1-2-3-4-1-1\" data-name=\"google brand icon\">\n                            </i>\n                            Google\n                        </button>\n                    </div>\n                </div>\n                <!-- Right Side Footer -->\n                <div class=\"animate-footer mt-16 flex flex-col items-center gap-8\" data-kid=\"1-2-4\" data-name=\"footer section\">\n                    <p class=\"text-sm text-gray-400 font-medium\" data-kid=\"1-2-4-1\" data-name=\"contact support text\">\n                        ¿Problemas para entrar?\n                        <a class=\"text-[#15202B] font-bold border-b border-[#F0F1F3] hover:border-[#F56B45] hover:text-[#F56B45]\" data-kid=\"1-2-4-1-1\" data-name=\"contact support link\" href=\"#\">\n                            Contacta al administrador.\n                        </a>\n                    </p>\n                    <div class=\"flex items-center gap-2.5 px-5 py-2.5 bg-[#4ADE80]/5 border border-[#4ADE80]/15 rounded-full text-[10px] font-bold text-[#4ADE80] uppercase tracking-widest\" data-kid=\"1-2-4-2\" data-name=\"security badge\">\n                        <i class=\"ti ti-shield-check text-base\" data-kid=\"1-2-4-2-1\" data-name=\"shield check icon\">\n                        </i>\n                        Acceso encriptado y seguro\n                    </div>\n                </div>\n            </section>\n        </div>\n        <style>\n            @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700&family=Atkinson+Hyperlegible:ital,wght@0,400;0,700;1,400&display=swap');\n        @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n        body {\n            margin: 0;\n            padding: 0;\n        }\n\n        .login-input {\n            transition: border-color 0.3s ease, box-shadow 0.3s ease, background-color 0.3s ease;\n        }\n        .login-input:focus {\n            border-color: #F56B45;\n            background-color: #fff;\n            box-shadow: 0 0 0 4px rgba(245, 107, 69, 0.1);\n        }\n\n        .login-button-primary {\n            transition: transform 0.2s ease, background-color 0.3s ease, box-shadow 0.3s ease;\n        }\n        .login-button-primary:active {\n            transform: scale(0.98);\n        }\n\n        .login-button-secondary {\n            transition: transform 0.2s ease, background-color 0.3s ease, border-color 0.3s ease;\n        }\n        .login-button-secondary:active {\n            transform: scale(0.98);\n        }\n        </style>\n        <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n        </script>\n        <script>\n            document.addEventListener('DOMContentLoaded', () => {\n            const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });\n\n            // Entrance Animations\n            tl.from('.animate-left-brand', { x: -40, opacity: 0, duration: 1 })\n              .from('.animate-left-title', { y: 30, opacity: 0, duration: 1 }, '-=0.7')\n              .from('.animate-left-subtitle', { y: 20, opacity: 0, duration: 1 }, '-=0.8')\n              .from('.animate-left-status', { y: 20, opacity: 0, duration: 1 }, '-=0.7')\n              \n              .from('.animate-badge', { y: -20, opacity: 0, duration: 0.8 }, '0.5')\n              .from('.animate-card', { y: 40, opacity: 0, duration: 1 }, '0.6')\n              .from('.animate-form-group', { y: 20, opacity: 0, duration: 0.6, stagger: 0.1 }, '0.8')\n              .from('.animate-footer', { opacity: 0, duration: 1 }, '1.2');\n\n            // Interactive Icons for focus\n            const inputs = document.querySelectorAll('.login-input');\n            inputs.forEach(input => {\n                input.addEventListener('focus', () => {\n                    gsap.to(input.parentElement.querySelector('i'), {\n                        color: '#F56B45',\n                        scale: 1.1,\n                        duration: 0.3\n                    });\n                });\n                input.addEventListener('blur', () => {\n                    gsap.to(input.parentElement.querySelector('i'), {\n                        color: '#9CA3AF',\n                        scale: 1,\n                        duration: 0.3\n                    });\n                });\n            });\n        });\n        </script>\n    ",
      "comments": [],
      "created": "2026-07-27T02:40:52.679316+00:00",
      "modified": "2026-07-27T02:40:52.679316+00:00",
      "id": "var_cd536be105e5",
      "overrides": {
